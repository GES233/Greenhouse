<% # Tailwind %>
<% # SSE Client Scripts %>
<%= if @options do %>
  <%= if Map.get(@options, "math") do %>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
  <% end %>
  <%= if Map.get(@options, "pdf") do %>
  <% end %>
  <%= if Map.get(@options, "music") do %>
    <script src="/assets/abcjs/abcjs-plugin-min.js" type="text/javascript"></script>
    <script src="/assets/abcjs/abcjs-basic-min.js"></script>
    <script>
      // Render ABC notation code blocks to sheet music
      document.addEventListener("DOMContentLoaded", function() {
        var abcBlocks = document.querySelectorAll("pre.abc code");
        abcBlocks.forEach(function(code) {
          var pre = code.parentElement;
          var abcText = code.textContent;
          var paper = document.createElement("div");
          paper.className = "abc-rendered";
          pre.parentNode.replaceChild(paper, pre);
          ABCJS.renderAbc(paper, abcText, {
            responsive: "resize",
            staffwidth: 720
          });
        });
      });
    </script>
  <% end %>
  <%= if Map.get(@options, "calendar") do %>
    <!-- https://fullcalendar.io/docs/initialize-browser-esm -->
    <script type='importmap'>
      {
        "imports": {
          "@fullcalendar/core": "https://esm.sh/@fullcalendar/core@6.1.20",
          "@fullcalendar/daygrid": "https://esm.sh/@fullcalendar/daygrid@6.1.20"
        }
      }
    </script>
    <script type='module' src='/assets/fullcalendar.js'></script>
  <% end %>
<% end %>
<%= @maybe_extra %>
